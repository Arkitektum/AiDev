#!/usr/bin/env bash
# aidev — start Docker (if needed), then run claude-docker in the
# project directory configured for the named app.
#
# Usage: aidev <app-name> [-r|--resume [session-id]] [-- claude-docker-args...]
# Config: ${XDG_CONFIG_HOME:-~/.config}/aidev/apps.conf
#         one entry per line, format: name=/absolute/path
#         Per-app options, optional: .../aidev/apps/<app-name>.conf

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/aidev"
CONFIG_FILE="$CONFIG_DIR/apps.conf"
USAGE_FILE="$CONFIG_DIR/usage.conf"
UPDATE_FILE="$CONFIG_DIR/update.conf"
# Optional per-app options (extra domains, extra directories): <name>.conf
APP_OPTIONS_DIR="$CONFIG_DIR/apps"
DOCKER_WAIT_SECONDS=120
# Where Docker Desktop's installer puts docker.exe; used under WSL when
# docker.exe is not on PATH.
DOCKER_EXE_DEFAULT='C:\Program Files\Docker\Docker\resources\bin\docker.exe'
UPDATE_CHECK_INTERVAL=86400  # seconds between background update checks (24h)
# How deep below a known project location to look for candidate directories
# when registering a new app (1 = siblings only, 2 = also their subfolders).
# Anything but a positive number would only break the search, so fall back.
SUGGEST_MAX_DEPTH="${AIDEV_SUGGEST_DEPTH:-2}"
case "$SUGGEST_MAX_DEPTH" in
    ''|0|*[!0-9]*) SUGGEST_MAX_DEPTH=2 ;;
esac
# Upper bound on suggestions, so the numbered picker stays usable.
SUGGEST_MAX_ITEMS=200
# Set AIDEV_SUGGEST_DEBUG=1 to have the search explain, on stderr, what it
# looked at and why each folder was offered or held back.
SUGGEST_DEBUG="${AIDEV_SUGGEST_DEBUG:-}"

die() { printf 'aidev: %s\n' "$*" >&2; exit 1; }

require_modern_bash() {
    # aidev uses associative arrays and the ${x,,} lowercase expansion, both
    # bash 4. macOS still ships 3.2 as /bin/bash, so '#!/usr/bin/env bash'
    # can land on a shell too old to run this script. Homebrew installs a
    # current bash beside the system one rather than replacing it — when we
    # are started by the old one, find the new one and hand over to it.
    [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] || return 0

    local candidates=(/opt/homebrew/bin/bash /usr/local/bin/bash) candidate on_path
    on_path="$(command -v bash 2>/dev/null || true)"
    [ -z "$on_path" ] || candidates+=("$on_path")

    for candidate in "${candidates[@]}"; do
        [ -x "$candidate" ] || continue
        # Ask the candidate itself, so an equally old bash cannot send us
        # round in a loop.
        "$candidate" -c '[ "${BASH_VERSINFO[0]}" -ge 4 ]' 2>/dev/null || continue
        exec "$candidate" "$0" "$@"
    done

    die "needs bash 4 or newer, but is running ${BASH_VERSION:-an unknown version}.
      macOS ships bash 3.2 as /bin/bash. Install a current one with:
        brew install bash
      No Homebrew? See https://brew.sh."
}
require_modern_bash "$@"

dbg_suggest() {
    # Suggestions go to stdout, so tracing goes to stderr.
    [ -n "$SUGGEST_DEBUG" ] || return 0
    printf 'aidev[suggest]: %s\n' "$*" >&2
}

usage() {
    cat <<EOF
Usage:
  aidev [-r|--resume]       Show an interactive picker of registered apps,
                            then run the same flow as 'aidev <app-name>'.
  aidev <app-name> [-r|--resume [session-id]] [-- claude-docker-args...]
                            Start Docker Desktop (if needed) and run
                            'claude-docker' in the project directory
                            registered for <app-name>. Prompts to register
                            <app-name> if it is unknown. With -r/--resume,
                            forwards --resume to claude-docker so you can
                            pick a previous Claude session. Give a session-id
                            after -r (e.g. 'aidev <app-name> -r <session-id>')
                            to resume that session directly. The app name must
                            come before -r for the session-id to attach.
                            Anything after '--' is passed on to claude-docker
                            as is, e.g. 'aidev <app-name> -- --add-dir ../lib'.
  aidev remove [app-name]   Remove an app from the config. With no name,
                            shows the interactive picker to choose which
                            app to remove.
  aidev rename [old-name [new-name]]
                            Rename a registered app, keeping its directory.
                            With no old-name, shows the interactive picker;
                            with no new-name, prompts for one.
  aidev config [app-name]   Create, change or clear an app's options (extra
                            domains and directories) in an editor. With no
                            name, shows the interactive picker. Checked
                            before saving; comment out or empty every
                            setting to clear.
  aidev update              Update aidev itself to the latest origin/main
                            (fast-forward only; refuses if the checkout has
                            uncommitted changes or has diverged).
  aidev -h | --help         Show this help.

Config file: $CONFIG_FILE
  Format:    one 'name=/absolute/path' entry per line.

Per-app options (optional, edit with 'aidev config'):
                     $APP_OPTIONS_DIR/<app-name>.conf
  allow_domains = .example.com, .example.org
                        Extra domains the container may reach; added to
                        CLAUDE_DOCKER_ALLOW_DOMAINS.
  add_dir = ../shared-lib
                        Extra directory to mount, passed on as --add-dir.
                        Relative paths are relative to the app directory.
                        Under WSL, a Windows path (C:\...) also works.
  Both keys may be repeated, and a key left empty is ignored. Lines
  starting with '#' are comments.

Environment:
  VISUAL, EDITOR        Editor for 'aidev config'. If neither is set, VS Code
                        ('code --wait') is used when installed, else nano,
                        else vi.
  AIDEV_SUGGEST_DEPTH   How deep to look for directory suggestions when
                        registering an app (default 2; 1 = siblings only).
  AIDEV_SUGGEST_DEBUG   Set to 1 to trace that search on stderr: which
                        folders were looked at and why each was offered
                        or held back.

Note: 'remove', 'rename', 'config', 'update' and 'help' are reserved and
      cannot be used as app names.
EOF
    exit "${1:-1}"
}

ensure_config() {
    mkdir -p "$CONFIG_DIR"
    [ -f "$CONFIG_FILE" ] || : > "$CONFIG_FILE"
}

lookup_app() {
    # Case-insensitive match. Echoes the stored path (config preserves
    # whatever case the user used at registration).
    local name="$1"
    awk -F= -v key="$name" 'tolower($1) == tolower(key) { sub(/^[^=]*=/, ""); print; exit }' "$CONFIG_FILE"
}

canonical_name() {
    # Case-insensitive match. Echoes the name as stored in the config.
    local name="$1"
    awk -F= -v key="$name" 'tolower($1) == tolower(key) { print $1; exit }' "$CONFIG_FILE"
}

sorted_apps() {
    # Emit apps.conf entries ordered by most-recent usage first, falling
    # back to original file order for apps without a recorded timestamp.
    local usage="$USAGE_FILE"
    awk -F= -v usage="$usage" '
        BEGIN {
            while ((getline line < usage) > 0) {
                n = split(line, f, "=")
                if (n >= 2) ts[tolower(f[1])] = f[2] + 0
            }
            close(usage)
        }
        {
            key = tolower($1)
            t = (key in ts) ? ts[key] : 0
            printf "%d\t%d\t%s\n", t, NR, $0
        }
    ' "$CONFIG_FILE" \
    | sort -t$'\t' -k1,1nr -k2,2n \
    | cut -f3-
}

record_usage() {
    # Upsert "<name>=<unix-time>" in USAGE_FILE (case-insensitive on name).
    local name="$1" tmp now
    now="$(date +%s)"
    mkdir -p "$CONFIG_DIR"
    tmp="$(mktemp "${USAGE_FILE}.XXXXXX")"
    if [ -f "$USAGE_FILE" ]; then
        awk -F= -v key="$name" 'tolower($1) != tolower(key)' "$USAGE_FILE" > "$tmp"
    fi
    printf '%s=%s\n' "$name" "$now" >> "$tmp"
    mv "$tmp" "$USAGE_FILE"
}

# --- Self-update --------------------------------------------------------------

_REPO_DIR=""
repo_dir() {
    # Resolve the directory of the real aidev script (following the symlink
    # that install.sh creates). Cached after first call.
    #
    # Walked by hand rather than with 'readlink -f': that flag is a GNU
    # coreutils extension and macOS ships BSD readlink, where falling back to
    # the unresolved path would hand back ~/.local/bin — not a git checkout —
    # and silently turn the update check into a no-op.
    if [ -z "$_REPO_DIR" ]; then
        local src dir hops=0
        src="${BASH_SOURCE[0]}"
        while [ -L "$src" ]; do
            hops=$((hops + 1))
            [ "$hops" -le 40 ] || die "symlink loop while resolving $src"
            dir="$(cd -P "$(dirname "$src")" && pwd)"
            src="$(readlink "$src")"
            # A relative link points at a sibling of the link, not of us.
            case "$src" in
                /*) ;;
                *) src="$dir/$src" ;;
            esac
        done
        _REPO_DIR="$(cd -P "$(dirname "$src")" && pwd)"
    fi
    printf '%s\n' "$_REPO_DIR"
}

git_repo_ready() {
    # True only when the checkout is a git repo sitting on 'main' with
    # 'origin/main' as its upstream — i.e. a normal end-user install, not a
    # developer working on a feature branch. Keeps the banner from nagging
    # during development.
    local rd
    rd="$(repo_dir)"
    git -C "$rd" rev-parse --git-dir >/dev/null 2>&1 || return 1
    [ "$(git -C "$rd" rev-parse --abbrev-ref HEAD 2>/dev/null)" = "main" ] || return 1
    git -C "$rd" rev-parse --verify --quiet origin/main >/dev/null 2>&1
}

read_update_field() {
    # Echo the value of key "$1" from UPDATE_FILE, or empty if absent.
    [ -f "$UPDATE_FILE" ] || return 0
    awk -F= -v key="$1" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$UPDATE_FILE"
}

write_update_cache() {
    # Atomically write "last_check" and "behind" to UPDATE_FILE.
    local last_check="$1" behind="$2" tmp
    mkdir -p "$CONFIG_DIR"
    tmp="$(mktemp "${UPDATE_FILE}.XXXXXX")"
    printf 'last_check=%s\nbehind=%s\n' "$last_check" "$behind" > "$tmp"
    mv "$tmp" "$UPDATE_FILE"
}

update_banner() {
    # Print a one-line nudge if the cached check says we're behind origin/main.
    # Reads only from cache: instant and offline-safe.
    git_repo_ready || return 0
    local behind
    behind="$(read_update_field behind)"
    case "$behind" in
        ''|0|*[!0-9]*) return 0 ;;
    esac
    local plural="commits"
    [ "$behind" = "1" ] && plural="commit"
    printf "aidev: update available — %s %s behind origin/main. Run 'aidev update'.\n" \
        "$behind" "$plural" >&2
}

maybe_refresh_update_cache() {
    # If the cache is stale, fetch + recompute in the background so the current
    # run never waits on the network. The fresh result shows on the next run.
    git_repo_ready || return 0

    local now last_check rd
    now="$(date +%s)"
    last_check="$(read_update_field last_check)"
    case "$last_check" in ''|*[!0-9]*) last_check=0 ;; esac
    [ $((now - last_check)) -ge "$UPDATE_CHECK_INTERVAL" ] || return 0

    # Bump the timestamp now so concurrent invocations don't all fetch.
    write_update_cache "$now" "$(read_update_field behind)"

    rd="$(repo_dir)"
    {
        # Never prompt: GIT_TERMINAL_PROMPT=0 turns a missing-credentials
        # situation into a silent failure instead of an interactive prompt,
        # while still letting a configured credential helper supply cached
        # credentials non-interactively. stdin is detached for good measure.
        GIT_TERMINAL_PROMPT=0 git -C "$rd" fetch --quiet origin main </dev/null 2>/dev/null || exit 0
        local behind
        behind="$(git -C "$rd" rev-list --count main..origin/main 2>/dev/null)" || exit 0
        case "$behind" in ''|*[!0-9]*) exit 0 ;; esac
        write_update_cache "$now" "$behind"
    } >/dev/null 2>&1 &
    disown 2>/dev/null || true
}

cmd_update() {
    local rd local_sha
    rd="$(repo_dir)"
    git -C "$rd" rev-parse --git-dir >/dev/null 2>&1 \
        || die "aidev is not a git checkout ($rd) — update only works for git installs."

    # Protect any work in progress: refuse on a dirty tree.
    if ! git -C "$rd" diff --quiet || ! git -C "$rd" diff --cached --quiet; then
        die "uncommitted changes in $rd — commit or stash them, then retry."
    fi

    echo "Updating aidev ($rd)..."
    if ! git -C "$rd" pull --ff-only; then
        die "could not fast-forward — the checkout has diverged from origin/main. Resolve manually (e.g. 'git -C $rd pull --rebase')."
    fi

    # Clear the banner: we are now up to date.
    write_update_cache "$(date +%s)" 0

    local_sha="$(git -C "$rd" rev-parse --short HEAD 2>/dev/null)"
    printf "Updated to %s. Takes effect on the next run.\n" "${local_sha:-latest}"
}

validate_app_name() {
    local name="$1"
    case "$name" in
        ''|*=*|*/*|*[[:space:]]*) die "Invalid app name: '$name'" ;;
    esac
    case "${name,,}" in
        remove|rename|config|update|help|-h|--help) die "'$name' is reserved and cannot be used as an app name." ;;
    esac
}

register_app() {
    local name="$1" path ans
    validate_app_name "$name"

    printf "App '%s' is not registered.\n" "$name"
    read -r -p "Register it now? [Y/n] " ans
    case "${ans:-Y}" in
        [Yy]*|'') ;;
        *) die "Aborted." ;;
    esac

    path="$(choose_project_dir "$name")"
    [ -n "$path" ] || die "No path provided."
    path="${path/#\~/$HOME}"
    [ -d "$path" ] || die "Directory does not exist: $path"
    path="$(cd "$path" && pwd)"

    printf '%s=%s\n' "$name" "$path" >> "$CONFIG_FILE"
    printf "Registered: %s -> %s\n" "$name" "$path"
}

# Shared fzf settings for both pickers, so they look and behave alike.
# Deliberately no --no-info: fzf's counter ("12/57") is what tells you the
# list is longer than the window. The header spells out the keys, since a
# list that fits looks identical to one that is merely scrolled to the top.
FZF_OPTS=(
    --height=60%
    --layout=reverse
    --no-sort
    --info=default
    --header='Type to filter | Up/Down to scroll | Enter to select'
)

pick_app() {
    # Interactive picker. Echoes the chosen app name to stdout; all UI
    # output goes to stderr so callers can capture the result.
    # Uses fzf (arrow keys + fuzzy search) if installed, otherwise falls
    # back to a numbered prompt. Entries ordered by most-recent usage.
    ensure_config
    if [ ! -s "$CONFIG_FILE" ]; then
        echo "No apps registered yet." >&2
        echo "Run 'aidev <name>' to register one, or 'aidev -h' for help." >&2
        exit 1
    fi

    local sorted width
    sorted="$(sorted_apps)"
    width="$(printf '%s\n' "$sorted" | awk -F= '{ if (length($1) > w) w = length($1) } END { print w }')"

    # Apps whose options file sets something get a marker, in a column of
    # its own so the markers line up. The column is left out altogether
    # when no app has one, so the list looks as it always did.
    local names=() paths=() marks=() rows=() n p f i mark_fmt=""
    while IFS='=' read -r n p; do
        names+=("$n")
        paths+=("$p")
        f="$(find_app_options "$n")"
        if [ -n "$f" ] && has_app_options "$f"; then
            marks+=("[has config]")
            mark_fmt="%-12s  "
        else
            marks+=("")
        fi
    done <<< "$sorted"
    for (( i=0; i<${#names[@]}; i++ )); do
        rows+=("$(printf "%-*s  ${mark_fmt}%s" "$width" "${names[i]}" \
            ${mark_fmt:+"${marks[i]}"} "${paths[i]}")")
    done

    if command -v fzf >/dev/null 2>&1; then
        local line
        line="$(
            printf '%s\n' "${rows[@]}" \
            | fzf --prompt='aidev > ' "${FZF_OPTS[@]}"
        )" || die "Aborted."
        [ -n "$line" ] || die "Aborted."
        # Names cannot contain whitespace (validate_app_name), so the
        # first whitespace-delimited token is the name.
        printf '%s\n' "${line%%[[:space:]]*}"
        return
    fi

    local count choice
    count=${#names[@]}

    echo "Registered apps:" >&2
    for (( i=0; i<count; i++ )); do
        printf "  %d) %s\n" "$((i+1))" "${rows[i]}" >&2
    done

    printf "Pick app [1-%d] (q to quit): " "$count" >&2
    read -r choice
    case "$choice" in
        ''|q|Q) die "Aborted." ;;
        *[!0-9]*) die "Invalid choice: $choice" ;;
    esac
    [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ] \
        || die "Choice out of range: $choice"

    printf '%s\n' "${names[$((choice-1))]}"
}

pick_line() {
    # Generic picker over newline-delimited items read from stdin. Echoes
    # the chosen line to stdout; all UI goes to stderr. Uses fzf if
    # installed, otherwise a numbered prompt. Returns 1 on abort/empty so
    # callers can decide how to handle cancellation (unlike pick_app, which
    # dies).
    local prompt="${1:-pick > }"
    local items
    items="$(cat)"
    [ -n "$items" ] || return 1

    if command -v fzf >/dev/null 2>&1; then
        local line
        line="$(
            printf '%s\n' "$items" \
            | fzf --prompt="$prompt" "${FZF_OPTS[@]}"
        )" || return 1
        [ -n "$line" ] || return 1
        printf '%s\n' "$line"
        return 0
    fi

    local arr=() l count i choice
    while IFS= read -r l; do arr+=("$l"); done <<< "$items"
    count=${#arr[@]}
    for (( i=0; i<count; i++ )); do
        printf "  %d) %s\n" "$((i+1))" "${arr[i]}" >&2
    done
    printf "Pick [1-%d] (q to quit): " "$count" >&2
    # Items arrive on stdin, so read the user's choice from the terminal
    # (fzf reads /dev/tty for the same reason).
    read -r choice </dev/tty
    case "$choice" in
        ''|q|Q) return 1 ;;
        *[!0-9]*) return 1 ;;
    esac
    { [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; } || return 1
    printf '%s\n' "${arr[$((choice-1))]}"
}

is_project_root() {
    # True if the directory looks like a project in its own right, rather
    # than a container of projects. Used to keep a repo's src/, tests/,
    # bin/ ... out of the candidate list.
    # '.claude' is deliberately not a marker: a Claude session leaves one
    # behind in every directory it runs in — including the client and suite
    # folders whose whole purpose is to group projects.
    # On a hit, names the deciding marker in PROJECT_ROOT_MARKER, so the
    # debug trace can say what made up its mind.
    local d="$1" m
    PROJECT_ROOT_MARKER=""
    for m in .git package.json pyproject.toml go.mod Cargo.toml pom.xml \
             build.gradle build.gradle.kts; do
        if [ -e "$d/$m" ]; then PROJECT_ROOT_MARKER="$m"; return 0; fi
    done
    local saved_nullglob hit
    # 'shopt -p' exits 1 when the option is unset (the common case), which
    # would trip 'set -e' — the value it prints is still the right restore
    # command, so ignore the status.
    saved_nullglob="$(shopt -p nullglob || true)"
    shopt -s nullglob
    hit=("$d"/*.sln "$d"/*.csproj)
    eval "$saved_nullglob"
    [ ${#hit[@]} -gt 0 ] || return 1
    PROJECT_ROOT_MARKER="${hit[0]##*/}"
}

skip_dir_name() {
    # Directory names that are never a project of their own. Hidden names
    # need no entry here: the '*/' glob skips them without dotglob.
    case "$1" in
        node_modules|vendor|target|dist|build|out|bin|obj|__pycache__|venv) return 0 ;;
    esac
    return 1
}

walk_suggestions() {
    # Emit the unregistered directories below "$1", depth-first, so each
    # folder is followed by the candidates inside it. Recurses until
    # SUGGEST_MAX_DEPTH levels below the starting location. Reads and
    # updates suggest_dirs' locals (is_registered, offered, opened, emitted)
    # through bash's dynamic scope, and returns 2 once the item cap is
    # reached so that every caller up the stack unwinds.
    local dir="$1" depth="$2" d only_projects=0 budget what
    [ -d "$dir" ] || { dbg_suggest "$dir — gone, skipping"; return 0; }

    # Every folder is a candidate, except inside a project of its own: there
    # only the sub-projects are, since a repo's src/ and docs/ are no place
    # to start an app. The walk itself never stops, so an app suite kept in
    # a single repo — or a monorepo's packages — stays reachable.
    if is_project_root "$dir"; then only_projects=1; fi

    if [ -n "$SUGGEST_DEBUG" ]; then
        what="not a project itself — every subfolder is a candidate"
        [ "$only_projects" -eq 0 ] \
            || what="a project ($PROJECT_ROOT_MARKER) — only sub-projects are candidates"
        dbg_suggest "$dir (depth $depth${is_registered[$dir]:+, registered}): $what"
    fi

    # Levels still available below each child. Locations overlap — one can
    # sit inside another — so the same folder may be reached twice, deeper
    # the first time and shallower the second. Only the budget decides
    # whether to open it, never whether it has been met before.
    budget=$((SUGGEST_MAX_DEPTH - 1 - depth))

    # Registered paths are canonical, so "$dir" and the globbed children
    # are canonical too — no need to re-resolve.
    for d in "$dir"/*/; do
        d="${d%/}"
        skip_dir_name "${d##*/}" && { dbg_suggest "  ${d##*/}: skipped, build output"; continue; }

        if [ -n "${offered[$d]:-}" ]; then
            dbg_suggest "  ${d##*/}: listed already"
        elif [ -n "${is_registered[$d]:-}" ]; then
            dbg_suggest "  ${d##*/}: not offered, already registered"
        elif [ "$only_projects" -eq 1 ] && ! is_project_root "$d"; then
            dbg_suggest "  ${d##*/}: not offered, no project marker and we are inside a project"
        else
            [ "$emitted" -lt "$SUGGEST_MAX_ITEMS" ] \
                || { dbg_suggest "  item cap ($SUGGEST_MAX_ITEMS) reached, stopping"; return 2; }
            printf '%s\n' "$d"
            emitted=$((emitted + 1))
            offered["$d"]=1
            dbg_suggest "  ${d##*/}: offered"
        fi

        if [ "$budget" -le 0 ]; then
            dbg_suggest "  ${d##*/}: not opened, depth limit $SUGGEST_MAX_DEPTH reached"
        elif [ "${opened[$d]:-0}" -ge "$budget" ]; then
            dbg_suggest "  ${d##*/}: not opened again, already searched this deep"
        else
            opened["$d"]="$budget"
            walk_suggestions "$d" "$((depth + 1))" || return 2
        fi
    done
    return 0
}

suggest_dirs() {
    # Emit candidate project directories (absolute paths, one per line) for
    # a new app: unregistered directories found below each registered app's
    # parent location, down to SUGGEST_MAX_DEPTH levels, so both siblings of
    # your apps and the subfolders of grouping directories (e.g. an org
    # folder holding several repos) show up. Ordered depth-first, so a
    # folder's candidates are listed under it; locations hosting the most
    # registered apps come before others, ties break alphabetically.
    [ -s "$CONFIG_FILE" ] || { dbg_suggest "no apps registered yet ($CONFIG_FILE)"; return 0; }
    dbg_suggest "config $CONFIG_FILE, depth limit $SUGGEST_MAX_DEPTH, item cap $SUGGEST_MAX_ITEMS"

    local -A is_registered=() loc_count=()
    local p parent
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        is_registered["$p"]=1
        if [ -d "$p" ]; then
            dbg_suggest "registered: $p"
        else
            dbg_suggest "registered: $p — MISSING on disk"
        fi
        parent="$(dirname "$p")"
        loc_count["$parent"]=$(( ${loc_count["$parent"]:-0} + 1 ))
    done < <(awk -F= 'NF>=2 { sub(/^[^=]*=/, ""); print }' "$CONFIG_FILE")

    [ ${#loc_count[@]} -gt 0 ] || return 0

    # Locations ordered by registered-app count (desc), then name (asc).
    local locations=() loc
    while IFS=$'\t' read -r _ loc; do
        locations+=("$loc")
    done < <(
        for loc in "${!loc_count[@]}"; do
            printf '%d\t%s\n' "${loc_count[$loc]}" "$loc"
        done | sort -t$'\t' -k1,1nr -k2,2
    )

    dbg_suggest "searching from: ${locations[*]}"

    local -A offered=() opened=()
    local saved_nullglob emitted=0 capped=0
    saved_nullglob="$(shopt -p nullglob || true)"  # see is_project_root
    shopt -s nullglob
    for loc in "${locations[@]}"; do
        walk_suggestions "$loc" 0 || { capped=1; break; }
    done
    eval "$saved_nullglob"
    dbg_suggest "$emitted candidate(s) offered"

    [ "$capped" -eq 0 ] || printf \
        'aidev: more than %d candidate directories — showing the first %d; use manual entry for anything else.\n' \
        "$SUGGEST_MAX_ITEMS" "$SUGGEST_MAX_ITEMS" >&2
}

choose_project_dir() {
    # Resolve the project directory for a new app. If sibling directories of
    # existing apps can be suggested, offer them via the picker (plus a
    # manual-entry item); otherwise — or on abort/manual — fall back to the
    # free-form prompt. Echoes the chosen path to stdout; UI goes to stderr.
    local name="$1"
    local manual_label="[ Enter a path manually... ]"
    local suggestions
    suggestions="$(suggest_dirs)"

    if [ -n "$suggestions" ]; then
        local chosen
        chosen="$(
            { printf '%s\n' "$suggestions"; printf '%s\n' "$manual_label"; } \
            | pick_line "dir for '$name' > "
        )" || true
        if [ -n "$chosen" ] && [ "$chosen" != "$manual_label" ]; then
            printf '%s\n' "$chosen"
            return 0
        fi
    fi

    local path
    read -r -e -p "Project directory for '$name': " path
    printf '%s\n' "$path"
}

remove_app() {
    local name="$1" canon path ans tmp
    # No validate_app_name: being registered is what counts, and an app may
    # be registered under a name that was reserved later.
    ensure_config

    canon="$(canonical_name "$name")"
    [ -n "$canon" ] || die "App '$name' is not registered."
    path="$(lookup_app "$name")"

    local options
    options="$(find_app_options "$canon")"
    printf "Remove '%s' (%s)?" "$canon" "$path"
    [ -z "$options" ] || printf " This also deletes its options file %s." "$options"
    printf " [y/N] "
    read -r ans
    case "${ans:-N}" in
        [Yy]*) ;;
        *) die "Aborted." ;;
    esac

    tmp="$(mktemp "${CONFIG_FILE}.XXXXXX")"
    awk -F= -v key="$name" 'tolower($1) != tolower(key)' "$CONFIG_FILE" > "$tmp"
    mv "$tmp" "$CONFIG_FILE"

    if [ -f "$USAGE_FILE" ]; then
        tmp="$(mktemp "${USAGE_FILE}.XXXXXX")"
        awk -F= -v key="$name" 'tolower($1) != tolower(key)' "$USAGE_FILE" > "$tmp"
        mv "$tmp" "$USAGE_FILE"
    fi

    [ -z "$options" ] || rm -f -- "$options"

    printf "Removed: %s\n" "$canon"
}

rename_app() {
    local old="$1" new="${2:-}" canon path existing tmp
    # Only the new name is validated: an app registered under a name that
    # was reserved later must still be able to move off it.
    ensure_config

    canon="$(canonical_name "$old")"
    [ -n "$canon" ] || die "App '$old' is not registered."
    path="$(lookup_app "$old")"

    if [ -z "$new" ]; then
        read -r -e -p "New name for '$canon': " new
    fi
    validate_app_name "$new"

    # Reject a name already taken by a different app. A case-only rename
    # (e.g. 'MyApp' -> 'myapp') matches itself and is allowed.
    existing="$(canonical_name "$new")"
    if [ -n "$existing" ] && [ "${existing,,}" != "${canon,,}" ]; then
        die "App '$new' is already registered."
    fi

    # Rewrite the matching entry's name, keeping its value (path/timestamp).
    tmp="$(mktemp "${CONFIG_FILE}.XXXXXX")"
    awk -F= -v key="$old" -v new="$new" '
        tolower($1) == tolower(key) { sub(/^[^=]*=/, ""); printf "%s=%s\n", new, $0; next }
        { print }
    ' "$CONFIG_FILE" > "$tmp"
    mv "$tmp" "$CONFIG_FILE"

    if [ -f "$USAGE_FILE" ]; then
        tmp="$(mktemp "${USAGE_FILE}.XXXXXX")"
        awk -F= -v key="$old" -v new="$new" '
            tolower($1) == tolower(key) { sub(/^[^=]*=/, ""); printf "%s=%s\n", new, $0; next }
            { print }
        ' "$USAGE_FILE" > "$tmp"
        mv "$tmp" "$USAGE_FILE"
    fi

    # Take the app's options file along, case-only renames included.
    local options
    options="$(find_app_options "$canon")"
    if [ -n "$options" ] && [ "$options" != "$APP_OPTIONS_DIR/$new.conf" ]; then
        mv "$options" "$APP_OPTIONS_DIR/$new.conf"
    fi

    printf "Renamed: %s -> %s\n" "$canon" "$new"
}

find_app_options() {
    # Echoes the path of the app's options file, if there is one. Matched
    # case-insensitively, like app names everywhere else.
    local name="$1" file base
    [ -d "$APP_OPTIONS_DIR" ] || return 0
    for file in "$APP_OPTIONS_DIR"/*.conf; do
        [ -f "$file" ] || continue
        base="${file##*/}"
        base="${base%.conf}"
        if [ "${base,,}" = "${name,,}" ]; then
            printf '%s\n' "$file"
            return 0
        fi
    done
}

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

load_app_options() {
    # Reads the app's options file, if any, into APP_DOMAINS and APP_DIRS.
    local name="$1" app_dir="$2" file
    APP_OPTIONS_FILE=""
    APP_DOMAINS=()
    APP_DIRS=()

    file="$(find_app_options "$name")"
    [ -n "$file" ] || return 0
    APP_OPTIONS_FILE="$file"
    parse_app_options "$file" "$app_dir" "$file"
}

parse_app_options() {
    # Parses <src> into APP_DOMAINS and APP_DIRS. Errors name <file>
    # instead, so a draft being edited reports the real options file.
    # Strict on purpose: these settings widen what the container can reach,
    # so a typo should stop the launch rather than be quietly ignored.
    # Usage: parse_app_options <src> <app-dir> <file>
    local src="$1" app_dir="$2" file="$3" line key value item dir lineno=0
    local -a items

    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        line="$(trim "${line%$'\r'}")"
        case "$line" in
            ''|'#'*) continue ;;
            *=*) ;;
            *) die "$file:$lineno: expected 'key = value', got: $line" ;;
        esac
        key="$(trim "${line%%=*}")"
        value="$(trim "${line#*=}")"
        # A known key left empty is simply not set: emptying a value is how
        # people clear it, and it widens nothing, so there is no typo to stop.
        if [ -z "$value" ]; then
            case "$key" in allow_domains|add_dir) continue ;; esac
        fi

        case "$key" in
            allow_domains)
                IFS=', ' read -r -a items <<< "$value"
                for item in ${items[@]+"${items[@]}"}; do
                    [[ "$item" =~ ^\.?[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*$ ]] \
                        || die "$file:$lineno: not a domain: '$item'"
                    APP_DOMAINS+=("$item")
                done
                ;;
            add_dir)
                dir="$value"
                # Explorer's "Copy as path" wraps the path in double quotes.
                case "$dir" in '"'?*'"') dir="${dir:1:${#dir}-2}" ;; esac
                # Under WSL, accept Windows paths (C:\..., C:/..., \\server\...)
                # and mount their WSL equivalent.
                if is_wsl && [[ "$dir" =~ ^([A-Za-z]:[\\/]|\\\\) ]]; then
                    dir="$(wslpath -u "$dir" 2>/dev/null)" && [ -n "$dir" ] \
                        || die "$file:$lineno: cannot convert Windows path: $value"
                fi
                case "$dir" in
                    '~') dir="$HOME" ;;
                    '~/'*) dir="$HOME/${dir#'~/'}" ;;
                    /*) ;;
                    *) dir="$app_dir/$dir" ;;
                esac
                [ -d "$dir" ] || die "$file:$lineno: directory not found: $value"
                APP_DIRS+=("$(cd "$dir" && pwd)")
                ;;
            *) die "$file:$lineno: unknown option '$key' (expected allow_domains or add_dir)" ;;
        esac
    done < "$src"
}

has_app_options() {
    # True if the file sets anything: a line that is not blank, a comment
    # or a key left empty.
    grep -qvE '^[[:space:]]*(#.*|[^#=]*=[[:space:]]*)?$' "$1"
}

app_options_template() {
    local name="$1" path="$2"
    cat <<EOF
# aidev options for $name ($path)
# Applied every time 'aidev $name' starts. Remove the '#' in front of a
# setting to use it. Save and close the editor when you are done. To have
# no options, comment the settings out again or leave them empty.
#
# Extra domains the container may reach, separated by commas or spaces.
# A leading dot includes all subdomains:
# allow_domains = .example.com, .example.org
#
# Extra directories to mount, one per line. Relative paths are relative to
# the app directory, and a path may start with ~/ for your home directory.
# Under WSL, a Windows path works too:
# add_dir = ../shared-lib
# add_dir = ~/data/reference
# add_dir = C:\Users\you\Documents\reference
EOF
}

pick_editor() {
    # Echoes the editor command. VS Code before nano: most aidev users come
    # from Windows and know it already. '--wait' makes it block until the
    # file's tab is closed, which is what lets us check the result.
    if [ -n "${VISUAL:-}" ]; then
        printf '%s\n' "$VISUAL"
    elif [ -n "${EDITOR:-}" ]; then
        printf '%s\n' "$EDITOR"
    elif command -v code >/dev/null 2>&1; then
        printf '%s\n' "code --wait"
    elif command -v nano >/dev/null 2>&1; then
        printf '%s\n' nano
    elif command -v vi >/dev/null 2>&1; then
        printf '%s\n' vi
    else
        die "No editor found. Set EDITOR, e.g. 'EDITOR=nano aidev config <app-name>'."
    fi
}

config_app() {
    local name="$1" canon path file target workdir draft ans errors
    local -a editor
    validate_app_name "$name"
    ensure_config

    canon="$(canonical_name "$name")"
    [ -n "$canon" ] || die "App '$name' is not registered."
    path="$(lookup_app "$name")"

    file="$(find_app_options "$canon")"
    target="${file:-$APP_OPTIONS_DIR/$canon.conf}"

    # Edit a draft, never the file itself: it only replaces the real one
    # once it passes the same checks as at launch, so a typo can't end up
    # blocking the next start. A directory rather than a file from mktemp,
    # so the draft keeps a readable name (and a .conf suffix) everywhere.
    workdir="$(mktemp -d "${TMPDIR:-/tmp}/aidev-config.XXXXXX")"
    trap "rm -rf -- '$workdir'" EXIT
    draft="$workdir/$canon.conf"
    if [ -n "$file" ]; then
        cp "$file" "$draft"
    else
        app_options_template "$canon" "$path" > "$draft"
    fi
    cp "$draft" "$workdir/original"

    read -r -a editor <<< "$(pick_editor)"
    case "${editor[0]##*/}" in
        nano) echo "Opening in nano: save with Ctrl+O then Enter, exit with Ctrl+X." ;;
        code) echo "Opening in VS Code: save, then close the file's tab to continue." ;;
    esac

    while :; do
        "${editor[@]}" "$draft" || die "The editor reported an error; $target is unchanged."
        if errors="$( (parse_app_options "$draft" "$path" "$target") 2>&1 >/dev/null )"; then
            break
        fi
        printf '%s\n' "$errors" >&2
        read -r -p "Edit again? [Y/n] " ans
        case "${ans:-Y}" in
            [Yy]*) ;;
            *) die "Discarded; $target is unchanged." ;;
        esac
    done

    if cmp -s "$draft" "$workdir/original"; then
        if [ -n "$file" ]; then
            echo "No changes to $target."
        else
            echo "No options set for $canon."
        fi
    elif has_app_options "$draft"; then
        mkdir -p "$APP_OPTIONS_DIR"
        cp "$draft" "$target"
        echo "Saved $target."
    elif [ -n "$file" ]; then
        rm -f -- "$file"
        echo "Removed $file; $canon has no options now."
    else
        echo "No options set for $canon."
    fi
}

docker_ready() {
    docker info >/dev/null 2>&1
}

is_wsl() {
    [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null
}

is_macos() {
    [ "$(uname -s)" = Darwin ]
}

# Why docker.exe is not on PATH under WSL, as indented lines for the error
# message. WSL appends Windows' PATH to its own, and Docker Desktop's
# installer puts its bin directory on Windows' PATH; say which link is
# missing. Only called once the default location has been tried as well.
docker_exe_missing_reason() {
    local dirs dir windows_path=""
    IFS=: read -r -a dirs <<< "$PATH"
    for dir in "${dirs[@]}"; do
        case "${dir,,}" in
            */windows/system32) windows_path=1 ;;
        esac
    done

    if [ -z "$windows_path" ]; then
        if grep -Eiqs '^[[:space:]]*appendWindowsPath[[:space:]]*=[[:space:]]*false' /etc/wsl.conf; then
            echo "      Windows' PATH is not passed to WSL: /etc/wsl.conf sets appendWindowsPath = false."
        else
            echo "      PATH has no Windows directories, so Windows' PATH is not reaching WSL."
            echo "      Check whether a shell startup file (~/.bashrc, ~/.profile) overwrites PATH."
        fi
    else
        echo "      Windows' PATH reaches WSL, but has no Docker Desktop directory on it."
    fi

    echo "      No docker.exe at the default location ($DOCKER_EXE_DEFAULT) either —"
    echo "      is Docker Desktop installed on Windows?"
}

# docker.exe at Docker Desktop's default install location, if it is there.
default_docker_exe() {
    local exe
    exe="$(wslpath -u "$DOCKER_EXE_DEFAULT" 2>/dev/null)" || return 1
    [ -f "$exe" ] || return 1
    printf '%s\n' "$exe"
}

start_docker() {
    if is_macos; then
        # Docker Desktop is the only Docker on macOS, and 'open' returns as
        # soon as the app is launched — the wait loop in ensure_docker is
        # what actually waits for the daemon. '-g' leaves the focus where
        # it is instead of pulling the whole app to the front.
        echo "Starting Docker Desktop..."
        open -ga Docker \
            || die "Failed to launch Docker Desktop — is it installed in /Applications?"
        return
    fi

    if is_wsl; then
        # A Docker Desktop install whose directory never made it onto
        # Windows' PATH still has docker.exe at the default location.
        local docker_exe
        if ! docker_exe="$(command -v docker.exe)"; then
            docker_exe="$(default_docker_exe)" \
                || die "docker.exe not found on PATH, so Docker Desktop cannot be started.
$(docker_exe_missing_reason)"
            echo "Note: docker.exe is not on PATH; using $docker_exe"
        fi
        echo "Starting Docker Desktop..."
        "$docker_exe" desktop start >/dev/null 2>&1 \
            || die "Failed to invoke 'docker.exe desktop start'."
        return
    fi

    # Native Linux: let the active Docker context decide which daemon to start.
    local ctx
    ctx="$(docker context show 2>/dev/null || echo default)"

    if [ "$ctx" = "desktop-linux" ]; then
        echo "Starting Docker Desktop..."
        systemctl --user start docker-desktop \
            || die "Failed to start docker-desktop.service."
        return
    fi

    echo "Starting Docker Engine (may prompt for sudo password)..."
    sudo systemctl start docker \
        || die "Failed to start docker.service."
}

ensure_docker() {
    if docker_ready; then
        return
    fi

    start_docker

    local elapsed=0
    while ! docker_ready; do
        if [ "$elapsed" -ge "$DOCKER_WAIT_SECONDS" ]; then
            die "Docker did not become ready within ${DOCKER_WAIT_SECONDS}s."
        fi
        sleep 2
        elapsed=$((elapsed + 2))
    done
    echo "Docker is ready."
}

main() {
    # Show any cached "update available" nudge, then refresh the cache in the
    # background (throttled) so the next run reflects the latest origin/main.
    # Not for 'aidev update' itself: telling someone to run the command they
    # are running reads as a bug, and a background fetch started here would
    # race the pull that cmd_update is about to do in the same checkout.
    if [ "${1:-}" != update ]; then
        update_banner
        maybe_refresh_update_cache
    fi

    case "${1:-}" in
        -h|--help|help) usage 0 ;;
        remove)
            local target
            case $# in
                1) target="$(pick_app)" ;;
                2) target="$2" ;;
                *) die "Usage: aidev remove [app-name]" ;;
            esac
            remove_app "$target"
            return
            ;;
        rename)
            local old new
            case $# in
                1) old="$(pick_app)"; new="" ;;
                2) old="$2"; new="" ;;
                3) old="$2"; new="$3" ;;
                *) die "Usage: aidev rename [old-name [new-name]]" ;;
            esac
            rename_app "$old" "$new"
            return
            ;;
        config)
            local target
            case $# in
                1) target="$(pick_app)" ;;
                2) target="$2" ;;
                *) die "Usage: aidev config [app-name]" ;;
            esac
            config_app "$target"
            return
            ;;
        update)
            [ $# -eq 1 ] || die "Usage: aidev update"
            cmd_update
            return
            ;;
    esac

    local name="" path resume=0 session=""
    local -a passthrough=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --)
                # Everything after '--' belongs to claude-docker, untouched.
                shift
                passthrough=("$@")
                break
                ;;
            -r|--resume)
                resume=1
                # Consume the next token as the session id only if an app name
                # is already set and the token is not itself a flag. This keeps
                # 'aidev -r myapp' meaning app=myapp (picker), not a session id.
                if [ -n "$name" ] && [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; then
                    session="$2"
                    shift
                fi
                ;;
            -*) die "Unknown flag: $1 (to pass it on to claude-docker, put it after '--')" ;;
            *)
                [ -z "$name" ] || die "Multiple app names provided: '$name', '$1'"
                name="$1"
                ;;
        esac
        shift
    done

    if [ -z "$name" ]; then
        name="$(pick_app)"
    fi

    validate_app_name "$name"
    ensure_config

    local newly_registered=0
    path="$(lookup_app "$name")"
    if [ -z "$path" ]; then
        register_app "$name"
        path="$(lookup_app "$name")"
        newly_registered=1
    fi
    [ -d "$path" ] || die "Configured directory missing for '$name': $path"
    # Read before starting Docker, so a broken options file fails fast.
    load_app_options "$name" "$path"

    if [ "$newly_registered" -eq 1 ]; then
        local run_now
        read -r -p "Run claude-docker now? [Y/n] " run_now
        case "${run_now:-Y}" in
            [Yy]*|'') ;;
            *) echo "Done."; return ;;
        esac
    fi

    ensure_docker

    record_usage "$(canonical_name "$name")"

    # A file whose keys are all empty sets nothing, so there is nothing to show.
    if [ "${#APP_DOMAINS[@]}" -gt 0 ] || [ "${#APP_DIRS[@]}" -gt 0 ]; then
        echo "Options from $APP_OPTIONS_FILE (change with 'aidev config $(canonical_name "$name")'):"
        local item joined
        if [ "${#APP_DOMAINS[@]}" -gt 0 ]; then
            joined="$(IFS=,; printf '%s' "${APP_DOMAINS[*]}")"
            echo "  allow domains: ${joined//,/, }"
            # Add to, rather than replace, any domains given on the command line.
            export CLAUDE_DOCKER_ALLOW_DOMAINS="${CLAUDE_DOCKER_ALLOW_DOMAINS:+$CLAUDE_DOCKER_ALLOW_DOMAINS,}$joined"
        fi
        for item in ${APP_DIRS[@]+"${APP_DIRS[@]}"}; do
            echo "  add dir:       $item"
        done
    fi

    cd "$path"
    local -a cmd=(claude-docker)
    local dir
    # The '=' form takes exactly one path. claude-docker's plain --add-dir
    # takes every argument up to the next flag, so it would swallow a
    # following 'bash' or prompt given after '--'.
    for dir in ${APP_DIRS[@]+"${APP_DIRS[@]}"}; do
        cmd+=("--add-dir=$dir")
    done
    if [ "$resume" -eq 1 ]; then
        cmd+=(--resume)
        [ -z "$session" ] || cmd+=("$session")
    fi
    # The '+' guard keeps an empty array from tripping 'set -u' on bash < 4.4.
    cmd+=(${passthrough[@]+"${passthrough[@]}"})
    echo "Running ${cmd[*]} in $path"
    exec "${cmd[@]}"
}

main "$@"
