#!/usr/bin/env bash
# aidev — start Docker (if needed), then run claude-docker in the
# project directory configured for the named app.
#
# Usage: aidev <app-name> [-r|--resume [session-id]]
# Config: ${XDG_CONFIG_HOME:-~/.config}/aidev/apps.conf
#         one entry per line, format: name=/absolute/path

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/aidev"
CONFIG_FILE="$CONFIG_DIR/apps.conf"
USAGE_FILE="$CONFIG_DIR/usage.conf"
DOCKER_WAIT_SECONDS=120
# How deep below a known project location to look for candidate directories
# when registering a new app (1 = siblings only, 2 = also their subfolders).
# Anything but a positive number would only break the search, so fall back.
SUGGEST_MAX_DEPTH="${AIDEV_SUGGEST_DEPTH:-2}"
case "$SUGGEST_MAX_DEPTH" in
    ''|0|*[!0-9]*) SUGGEST_MAX_DEPTH=2 ;;
esac
# Upper bound on suggestions, so the numbered picker stays usable.
SUGGEST_MAX_ITEMS=200
# Set AIDEV_SUGGEST_DEBUG=1 to have the search explain, on stderr, what it
# looked at and why each folder was offered or held back.
SUGGEST_DEBUG="${AIDEV_SUGGEST_DEBUG:-}"

die() { printf 'aidev: %s\n' "$*" >&2; exit 1; }

dbg_suggest() {
    # Suggestions go to stdout, so tracing goes to stderr.
    [ -n "$SUGGEST_DEBUG" ] || return 0
    printf 'aidev[suggest]: %s\n' "$*" >&2
}

usage() {
    cat <<EOF
Usage:
  aidev [-r|--resume]       Show an interactive picker of registered apps,
                            then run the same flow as 'aidev <app-name>'.
  aidev <app-name> [-r|--resume [session-id]]
                            Start Docker Desktop (if needed) and run
                            'claude-docker' in the project directory
                            registered for <app-name>. Prompts to register
                            <app-name> if it is unknown. With -r/--resume,
                            forwards --resume to claude-docker so you can
                            pick a previous Claude session. Give a session-id
                            after -r (e.g. 'aidev <app-name> -r <session-id>')
                            to resume that session directly. The app name must
                            come before -r for the session-id to attach.
  aidev remove [app-name]   Remove an app from the config. With no name,
                            shows the interactive picker to choose which
                            app to remove.
  aidev rename [old-name [new-name]]
                            Rename a registered app, keeping its directory.
                            With no old-name, shows the interactive picker;
                            with no new-name, prompts for one.
  aidev -h | --help         Show this help.

Config file: $CONFIG_FILE
  Format:    one 'name=/absolute/path' entry per line.

Environment:
  AIDEV_SUGGEST_DEPTH   How deep to look for directory suggestions when
                        registering an app (default 2; 1 = siblings only).
  AIDEV_SUGGEST_DEBUG   Set to 1 to trace that search on stderr: which
                        folders were looked at and why each was offered
                        or held back.

Note: 'remove', 'rename' and 'help' are reserved and cannot be used as
      app names.
EOF
    exit "${1:-1}"
}

ensure_config() {
    mkdir -p "$CONFIG_DIR"
    [ -f "$CONFIG_FILE" ] || : > "$CONFIG_FILE"
}

lookup_app() {
    # Case-insensitive match. Echoes the stored path (config preserves
    # whatever case the user used at registration).
    local name="$1"
    awk -F= -v key="$name" 'tolower($1) == tolower(key) { sub(/^[^=]*=/, ""); print; exit }' "$CONFIG_FILE"
}

canonical_name() {
    # Case-insensitive match. Echoes the name as stored in the config.
    local name="$1"
    awk -F= -v key="$name" 'tolower($1) == tolower(key) { print $1; exit }' "$CONFIG_FILE"
}

sorted_apps() {
    # Emit apps.conf entries ordered by most-recent usage first, falling
    # back to original file order for apps without a recorded timestamp.
    local usage="$USAGE_FILE"
    awk -F= -v usage="$usage" '
        BEGIN {
            while ((getline line < usage) > 0) {
                n = split(line, f, "=")
                if (n >= 2) ts[tolower(f[1])] = f[2] + 0
            }
            close(usage)
        }
        {
            key = tolower($1)
            t = (key in ts) ? ts[key] : 0
            printf "%d\t%d\t%s\n", t, NR, $0
        }
    ' "$CONFIG_FILE" \
    | sort -t$'\t' -k1,1nr -k2,2n \
    | cut -f3-
}

record_usage() {
    # Upsert "<name>=<unix-time>" in USAGE_FILE (case-insensitive on name).
    local name="$1" tmp now
    now="$(date +%s)"
    mkdir -p "$CONFIG_DIR"
    tmp="$(mktemp "${USAGE_FILE}.XXXXXX")"
    if [ -f "$USAGE_FILE" ]; then
        awk -F= -v key="$name" 'tolower($1) != tolower(key)' "$USAGE_FILE" > "$tmp"
    fi
    printf '%s=%s\n' "$name" "$now" >> "$tmp"
    mv "$tmp" "$USAGE_FILE"
}

validate_app_name() {
    local name="$1"
    case "$name" in
        ''|*=*|*/*|*[[:space:]]*) die "Invalid app name: '$name'" ;;
    esac
    case "${name,,}" in
        remove|rename|help|-h|--help) die "'$name' is reserved and cannot be used as an app name." ;;
    esac
}

register_app() {
    local name="$1" path ans
    validate_app_name "$name"

    printf "App '%s' is not registered.\n" "$name"
    read -r -p "Register it now? [Y/n] " ans
    case "${ans:-Y}" in
        [Yy]*|'') ;;
        *) die "Aborted." ;;
    esac

    path="$(choose_project_dir "$name")"
    [ -n "$path" ] || die "No path provided."
    path="${path/#\~/$HOME}"
    [ -d "$path" ] || die "Directory does not exist: $path"
    path="$(cd "$path" && pwd)"

    printf '%s=%s\n' "$name" "$path" >> "$CONFIG_FILE"
    printf "Registered: %s -> %s\n" "$name" "$path"
}

pick_app() {
    # Interactive picker. Echoes the chosen app name to stdout; all UI
    # output goes to stderr so callers can capture the result.
    # Uses fzf (arrow keys + fuzzy search) if installed, otherwise falls
    # back to a numbered prompt. Entries ordered by most-recent usage.
    ensure_config
    if [ ! -s "$CONFIG_FILE" ]; then
        echo "No apps registered yet." >&2
        echo "Run 'aidev <name>' to register one, or 'aidev -h' for help." >&2
        exit 1
    fi

    local sorted width
    sorted="$(sorted_apps)"
    width="$(printf '%s\n' "$sorted" | awk -F= '{ if (length($1) > w) w = length($1) } END { print w }')"

    if command -v fzf >/dev/null 2>&1; then
        local line
        line="$(
            printf '%s\n' "$sorted" \
            | awk -F= -v w="$width" '{
                name = $1
                sub(/^[^=]*=/, "")
                printf "%-*s  %s\n", w, name, $0
            }' \
            | fzf --prompt='aidev > ' --height=40% --layout=reverse --no-info --no-sort
        )" || die "Aborted."
        [ -n "$line" ] || die "Aborted."
        # Names cannot contain whitespace (validate_app_name), so the
        # first whitespace-delimited token is the name.
        printf '%s\n' "${line%%[[:space:]]*}"
        return
    fi

    local names=() paths=() count i choice
    while IFS='=' read -r n p; do
        names+=("$n")
        paths+=("$p")
    done <<< "$sorted"
    count=${#names[@]}

    echo "Registered apps:" >&2
    for (( i=0; i<count; i++ )); do
        printf "  %d) %-*s  %s\n" "$((i+1))" "$width" "${names[i]}" "${paths[i]}" >&2
    done

    printf "Pick app [1-%d] (q to quit): " "$count" >&2
    read -r choice
    case "$choice" in
        ''|q|Q) die "Aborted." ;;
        *[!0-9]*) die "Invalid choice: $choice" ;;
    esac
    [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ] \
        || die "Choice out of range: $choice"

    printf '%s\n' "${names[$((choice-1))]}"
}

pick_line() {
    # Generic picker over newline-delimited items read from stdin. Echoes
    # the chosen line to stdout; all UI goes to stderr. Uses fzf if
    # installed, otherwise a numbered prompt. Returns 1 on abort/empty so
    # callers can decide how to handle cancellation (unlike pick_app, which
    # dies).
    local prompt="${1:-pick > }"
    local items
    items="$(cat)"
    [ -n "$items" ] || return 1

    if command -v fzf >/dev/null 2>&1; then
        local line
        line="$(
            printf '%s\n' "$items" \
            | fzf --prompt="$prompt" --height=40% --layout=reverse --no-info --no-sort
        )" || return 1
        [ -n "$line" ] || return 1
        printf '%s\n' "$line"
        return 0
    fi

    local arr=() l count i choice
    while IFS= read -r l; do arr+=("$l"); done <<< "$items"
    count=${#arr[@]}
    for (( i=0; i<count; i++ )); do
        printf "  %d) %s\n" "$((i+1))" "${arr[i]}" >&2
    done
    printf "Pick [1-%d] (q to quit): " "$count" >&2
    # Items arrive on stdin, so read the user's choice from the terminal
    # (fzf reads /dev/tty for the same reason).
    read -r choice </dev/tty
    case "$choice" in
        ''|q|Q) return 1 ;;
        *[!0-9]*) return 1 ;;
    esac
    { [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; } || return 1
    printf '%s\n' "${arr[$((choice-1))]}"
}

is_project_root() {
    # True if the directory looks like a project in its own right, rather
    # than a container of projects. Used to keep a repo's src/, tests/,
    # bin/ ... out of the candidate list.
    # '.claude' is deliberately not a marker: a Claude session leaves one
    # behind in every directory it runs in — including the client and suite
    # folders whose whole purpose is to group projects.
    # On a hit, names the deciding marker in PROJECT_ROOT_MARKER, so the
    # debug trace can say what made up its mind.
    local d="$1" m
    PROJECT_ROOT_MARKER=""
    for m in .git package.json pyproject.toml go.mod Cargo.toml pom.xml \
             build.gradle build.gradle.kts; do
        if [ -e "$d/$m" ]; then PROJECT_ROOT_MARKER="$m"; return 0; fi
    done
    local saved_nullglob hit
    # 'shopt -p' exits 1 when the option is unset (the common case), which
    # would trip 'set -e' — the value it prints is still the right restore
    # command, so ignore the status.
    saved_nullglob="$(shopt -p nullglob || true)"
    shopt -s nullglob
    hit=("$d"/*.sln "$d"/*.csproj)
    eval "$saved_nullglob"
    [ ${#hit[@]} -gt 0 ] || return 1
    PROJECT_ROOT_MARKER="${hit[0]##*/}"
}

skip_dir_name() {
    # Directory names that are never a project of their own. Hidden names
    # need no entry here: the '*/' glob skips them without dotglob.
    case "$1" in
        node_modules|vendor|target|dist|build|out|bin|obj|__pycache__|venv) return 0 ;;
    esac
    return 1
}

walk_suggestions() {
    # Emit the unregistered directories below "$1", depth-first, so each
    # folder is followed by the candidates inside it. Recurses until
    # SUGGEST_MAX_DEPTH levels below the starting location. Reads and
    # updates suggest_dirs' locals (is_registered, offered, opened, emitted)
    # through bash's dynamic scope, and returns 2 once the item cap is
    # reached so that every caller up the stack unwinds.
    local dir="$1" depth="$2" d only_projects=0 budget what
    [ -d "$dir" ] || { dbg_suggest "$dir — gone, skipping"; return 0; }

    # Every folder is a candidate, except inside a project of its own: there
    # only the sub-projects are, since a repo's src/ and docs/ are no place
    # to start an app. The walk itself never stops, so an app suite kept in
    # a single repo — or a monorepo's packages — stays reachable.
    if is_project_root "$dir"; then only_projects=1; fi

    if [ -n "$SUGGEST_DEBUG" ]; then
        what="not a project itself — every subfolder is a candidate"
        [ "$only_projects" -eq 0 ] \
            || what="a project ($PROJECT_ROOT_MARKER) — only sub-projects are candidates"
        dbg_suggest "$dir (depth $depth${is_registered[$dir]:+, registered}): $what"
    fi

    # Levels still available below each child. Locations overlap — one can
    # sit inside another — so the same folder may be reached twice, deeper
    # the first time and shallower the second. Only the budget decides
    # whether to open it, never whether it has been met before.
    budget=$((SUGGEST_MAX_DEPTH - 1 - depth))

    # Registered paths are canonical, so "$dir" and the globbed children
    # are canonical too — no need to re-resolve.
    for d in "$dir"/*/; do
        d="${d%/}"
        skip_dir_name "${d##*/}" && { dbg_suggest "  ${d##*/}: skipped, build output"; continue; }

        if [ -n "${offered[$d]:-}" ]; then
            dbg_suggest "  ${d##*/}: listed already"
        elif [ -n "${is_registered[$d]:-}" ]; then
            dbg_suggest "  ${d##*/}: not offered, already registered"
        elif [ "$only_projects" -eq 1 ] && ! is_project_root "$d"; then
            dbg_suggest "  ${d##*/}: not offered, no project marker and we are inside a project"
        else
            [ "$emitted" -lt "$SUGGEST_MAX_ITEMS" ] \
                || { dbg_suggest "  item cap ($SUGGEST_MAX_ITEMS) reached, stopping"; return 2; }
            printf '%s\n' "$d"
            emitted=$((emitted + 1))
            offered["$d"]=1
            dbg_suggest "  ${d##*/}: offered"
        fi

        if [ "$budget" -le 0 ]; then
            dbg_suggest "  ${d##*/}: not opened, depth limit $SUGGEST_MAX_DEPTH reached"
        elif [ "${opened[$d]:-0}" -ge "$budget" ]; then
            dbg_suggest "  ${d##*/}: not opened again, already searched this deep"
        else
            opened["$d"]="$budget"
            walk_suggestions "$d" "$((depth + 1))" || return 2
        fi
    done
    return 0
}

suggest_dirs() {
    # Emit candidate project directories (absolute paths, one per line) for
    # a new app: unregistered directories found below each registered app's
    # parent location, down to SUGGEST_MAX_DEPTH levels, so both siblings of
    # your apps and the subfolders of grouping directories (e.g. an org
    # folder holding several repos) show up. Ordered depth-first, so a
    # folder's candidates are listed under it; locations hosting the most
    # registered apps come before others, ties break alphabetically.
    [ -s "$CONFIG_FILE" ] || { dbg_suggest "no apps registered yet ($CONFIG_FILE)"; return 0; }
    dbg_suggest "config $CONFIG_FILE, depth limit $SUGGEST_MAX_DEPTH, item cap $SUGGEST_MAX_ITEMS"

    local -A is_registered=() loc_count=()
    local p parent
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        is_registered["$p"]=1
        if [ -d "$p" ]; then
            dbg_suggest "registered: $p"
        else
            dbg_suggest "registered: $p — MISSING on disk"
        fi
        parent="$(dirname "$p")"
        loc_count["$parent"]=$(( ${loc_count["$parent"]:-0} + 1 ))
    done < <(awk -F= 'NF>=2 { sub(/^[^=]*=/, ""); print }' "$CONFIG_FILE")

    [ ${#loc_count[@]} -gt 0 ] || return 0

    # Locations ordered by registered-app count (desc), then name (asc).
    local locations=() loc
    while IFS=$'\t' read -r _ loc; do
        locations+=("$loc")
    done < <(
        for loc in "${!loc_count[@]}"; do
            printf '%d\t%s\n' "${loc_count[$loc]}" "$loc"
        done | sort -t$'\t' -k1,1nr -k2,2
    )

    dbg_suggest "searching from: ${locations[*]}"

    local -A offered=() opened=()
    local saved_nullglob emitted=0 capped=0
    saved_nullglob="$(shopt -p nullglob || true)"  # see is_project_root
    shopt -s nullglob
    for loc in "${locations[@]}"; do
        walk_suggestions "$loc" 0 || { capped=1; break; }
    done
    eval "$saved_nullglob"
    dbg_suggest "$emitted candidate(s) offered"

    [ "$capped" -eq 0 ] || printf \
        'aidev: more than %d candidate directories — showing the first %d; use manual entry for anything else.\n' \
        "$SUGGEST_MAX_ITEMS" "$SUGGEST_MAX_ITEMS" >&2
}

choose_project_dir() {
    # Resolve the project directory for a new app. If sibling directories of
    # existing apps can be suggested, offer them via the picker (plus a
    # manual-entry item); otherwise — or on abort/manual — fall back to the
    # free-form prompt. Echoes the chosen path to stdout; UI goes to stderr.
    local name="$1"
    local manual_label="[ Enter a path manually... ]"
    local suggestions
    suggestions="$(suggest_dirs)"

    if [ -n "$suggestions" ]; then
        local chosen
        chosen="$(
            { printf '%s\n' "$suggestions"; printf '%s\n' "$manual_label"; } \
            | pick_line "dir for '$name' > "
        )" || true
        if [ -n "$chosen" ] && [ "$chosen" != "$manual_label" ]; then
            printf '%s\n' "$chosen"
            return 0
        fi
    fi

    local path
    read -r -e -p "Project directory for '$name': " path
    printf '%s\n' "$path"
}

remove_app() {
    local name="$1" canon path ans tmp
    validate_app_name "$name"
    ensure_config

    canon="$(canonical_name "$name")"
    [ -n "$canon" ] || die "App '$name' is not registered."
    path="$(lookup_app "$name")"

    printf "Remove '%s' (%s)? [y/N] " "$canon" "$path"
    read -r ans
    case "${ans:-N}" in
        [Yy]*) ;;
        *) die "Aborted." ;;
    esac

    tmp="$(mktemp "${CONFIG_FILE}.XXXXXX")"
    awk -F= -v key="$name" 'tolower($1) != tolower(key)' "$CONFIG_FILE" > "$tmp"
    mv "$tmp" "$CONFIG_FILE"

    if [ -f "$USAGE_FILE" ]; then
        tmp="$(mktemp "${USAGE_FILE}.XXXXXX")"
        awk -F= -v key="$name" 'tolower($1) != tolower(key)' "$USAGE_FILE" > "$tmp"
        mv "$tmp" "$USAGE_FILE"
    fi

    printf "Removed: %s\n" "$canon"
}

rename_app() {
    local old="$1" new="${2:-}" canon path existing tmp
    validate_app_name "$old"
    ensure_config

    canon="$(canonical_name "$old")"
    [ -n "$canon" ] || die "App '$old' is not registered."
    path="$(lookup_app "$old")"

    if [ -z "$new" ]; then
        read -r -e -p "New name for '$canon': " new
    fi
    validate_app_name "$new"

    # Reject a name already taken by a different app. A case-only rename
    # (e.g. 'MyApp' -> 'myapp') matches itself and is allowed.
    existing="$(canonical_name "$new")"
    if [ -n "$existing" ] && [ "${existing,,}" != "${canon,,}" ]; then
        die "App '$new' is already registered."
    fi

    # Rewrite the matching entry's name, keeping its value (path/timestamp).
    tmp="$(mktemp "${CONFIG_FILE}.XXXXXX")"
    awk -F= -v key="$old" -v new="$new" '
        tolower($1) == tolower(key) { sub(/^[^=]*=/, ""); printf "%s=%s\n", new, $0; next }
        { print }
    ' "$CONFIG_FILE" > "$tmp"
    mv "$tmp" "$CONFIG_FILE"

    if [ -f "$USAGE_FILE" ]; then
        tmp="$(mktemp "${USAGE_FILE}.XXXXXX")"
        awk -F= -v key="$old" -v new="$new" '
            tolower($1) == tolower(key) { sub(/^[^=]*=/, ""); printf "%s=%s\n", new, $0; next }
            { print }
        ' "$USAGE_FILE" > "$tmp"
        mv "$tmp" "$USAGE_FILE"
    fi

    printf "Renamed: %s -> %s\n" "$canon" "$new"
}

docker_ready() {
    docker info >/dev/null 2>&1
}

is_wsl() {
    [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null
}

start_docker() {
    if is_wsl; then
        command -v docker.exe >/dev/null 2>&1 \
            || die "docker.exe not found on PATH — is Docker Desktop installed on Windows?"
        echo "Starting Docker Desktop..."
        docker.exe desktop start >/dev/null 2>&1 \
            || die "Failed to invoke 'docker.exe desktop start'."
        return
    fi

    # Native Linux: let the active Docker context decide which daemon to start.
    local ctx
    ctx="$(docker context show 2>/dev/null || echo default)"

    if [ "$ctx" = "desktop-linux" ]; then
        echo "Starting Docker Desktop..."
        systemctl --user start docker-desktop \
            || die "Failed to start docker-desktop.service."
        return
    fi

    echo "Starting Docker Engine (may prompt for sudo password)..."
    sudo systemctl start docker \
        || die "Failed to start docker.service."
}

ensure_docker() {
    if docker_ready; then
        return
    fi

    start_docker

    local elapsed=0
    while ! docker_ready; do
        if [ "$elapsed" -ge "$DOCKER_WAIT_SECONDS" ]; then
            die "Docker did not become ready within ${DOCKER_WAIT_SECONDS}s."
        fi
        sleep 2
        elapsed=$((elapsed + 2))
    done
    echo "Docker is ready."
}

main() {
    case "${1:-}" in
        -h|--help|help) usage 0 ;;
        remove)
            local target
            case $# in
                1) target="$(pick_app)" ;;
                2) target="$2" ;;
                *) die "Usage: aidev remove [app-name]" ;;
            esac
            remove_app "$target"
            return
            ;;
        rename)
            local old new
            case $# in
                1) old="$(pick_app)"; new="" ;;
                2) old="$2"; new="" ;;
                3) old="$2"; new="$3" ;;
                *) die "Usage: aidev rename [old-name [new-name]]" ;;
            esac
            rename_app "$old" "$new"
            return
            ;;
    esac

    local name="" path resume=0 session=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -r|--resume)
                resume=1
                # Consume the next token as the session id only if an app name
                # is already set and the token is not itself a flag. This keeps
                # 'aidev -r myapp' meaning app=myapp (picker), not a session id.
                if [ -n "$name" ] && [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; then
                    session="$2"
                    shift
                fi
                ;;
            -*) die "Unknown flag: $1" ;;
            *)
                [ -z "$name" ] || die "Multiple app names provided: '$name', '$1'"
                name="$1"
                ;;
        esac
        shift
    done

    if [ -z "$name" ]; then
        name="$(pick_app)"
    fi

    validate_app_name "$name"
    ensure_config

    local newly_registered=0
    path="$(lookup_app "$name")"
    if [ -z "$path" ]; then
        register_app "$name"
        path="$(lookup_app "$name")"
        newly_registered=1
    fi
    [ -d "$path" ] || die "Configured directory missing for '$name': $path"

    if [ "$newly_registered" -eq 1 ]; then
        local run_now
        read -r -p "Run claude-docker now? [Y/n] " run_now
        case "${run_now:-Y}" in
            [Yy]*|'') ;;
            *) echo "Done."; return ;;
        esac
    fi

    ensure_docker

    record_usage "$(canonical_name "$name")"

    cd "$path"
    if [ "$resume" -eq 1 ] && [ -n "$session" ]; then
        echo "Running claude-docker --resume $session in $path"
        exec claude-docker --resume "$session"
    elif [ "$resume" -eq 1 ]; then
        echo "Running claude-docker --resume in $path"
        exec claude-docker --resume
    else
        echo "Running claude-docker in $path"
        exec claude-docker
    fi
}

main "$@"
